# CompMap environment variables
# Copy to .env and fill in values

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=compmap_local

# API
DATA_CASES_PATH=data/cases

# Frontend
# Browser-visible URL (baked into the JS bundle at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Internal Docker network URL for server-side Next.js fetches
# Set to http://api:8000 when running via docker compose; leave unset for local dev
API_INTERNAL_URL=

# Optional: AI features (not required for v0 slice)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
